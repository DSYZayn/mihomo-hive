HIVE_HOST=0.0.0.0
HIVE_PORT=9990
HIVE_DATA_DIR=/data
HIVE_CONFIG=/data/hive.config.json
MIHOMO_BIN=mihomo
# 所有普通节点端口共用的入口认证；两项同时留空时关闭认证。
HIVE_PROXY_USERNAME=
HIVE_PROXY_PASSWORD=
# 可选覆盖监听地址和写入 Sub2API 的地址；留空沿用 hive.config.json。
# 公网部署时分别设置为 0.0.0.0 和代理服务器的公网 IP/域名。
HIVE_LISTEN_HOST=
HIVE_EXPORT_HOST=
# 订阅下载的出站代理；Docker daemon 的代理不会自动传给容器。
# HTTP(S) 代理示例：http://127.0.0.1:7890；SOCKS 示例：socks5h://127.0.0.1:1080。
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=localhost,127.0.0.1,::1
# 仅在订阅服务要求特定客户端标识时修改；留空沿用配置文件，默认 Clash.Meta。
HIVE_SUBSCRIPTION_USER_AGENT=
# 关闭后台订阅刷新、节点验活和 Sub2API 健康节点同步（默认开启）
HIVE_DISABLE_MAINTENANCE=false
